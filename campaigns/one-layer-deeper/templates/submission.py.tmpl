class Config:
    def __init__(self, vocab_size: int, max_seq_len: int) -> None:
        self.vocab_size = vocab_size
        self.max_seq_len = max_seq_len


class RMSNorm(nn.Module):
    def __init__(self, width: int) -> None:
        super().__init__()
        self.weight = nn.Parameter(torch.ones(width))

    def forward(self, x: Tensor) -> Tensor:
        return F.rms_norm(x, (x.shape[-1],), self.weight)


class OfficialBaselineBlock(nn.Module):
    def __init__(self, width: int, heads: int) -> None:
        super().__init__()
        if width % heads:
            raise ValueError("width must be divisible by heads")
        self.heads = heads
        self.attention_norm = RMSNorm(width)
        self.qkv = nn.Linear(width, 3 * width)
        self.out = nn.Linear(width, width)
        self.mixer_norm = RMSNorm(width)
        self.up = nn.Linear(width, 4 * width)
        self.down = nn.Linear(4 * width, width)

    def forward(self, x: Tensor, attention_mask: Tensor | None) -> Tensor:
        residual = x
        x = self.attention_norm(x)
        batch, length, width = x.shape
        q, k, v = self.qkv(x).chunk(3, dim=-1)
        head_width = width // self.heads
        q = q.view(batch, length, self.heads, head_width).transpose(1, 2)
        k = k.view(batch, length, self.heads, head_width).transpose(1, 2)
        v = v.view(batch, length, self.heads, head_width).transpose(1, 2)
        mask = None
        if attention_mask is not None:
            mask = attention_mask[:, None, None, :].to(dtype=torch.bool, device=x.device)
        x = F.scaled_dot_product_attention(q, k, v, attn_mask=mask)
        x = x.transpose(1, 2).contiguous().view(batch, length, width)
        x = residual + self.out(x)
        return x + self.down(F.gelu(self.up(self.mixer_norm(x))))


class TiedTransformerCell(nn.Module):
    def __init__(self, width: int, heads: int) -> None:
        super().__init__()
        if width % heads:
            raise ValueError("width must be divisible by heads")
        self.heads = heads
        self.norm1 = RMSNorm(width)
        self.qkv = nn.Linear(width, 3 * width, bias=False)
        self.out = nn.Linear(width, width, bias=False)
        self.norm2 = RMSNorm(width)
        self.up = nn.Linear(width, 4 * width, bias=False)
        self.down = nn.Linear(4 * width, width, bias=False)
        self.attn_gate = nn.Parameter(torch.tensor(-1.5))
        self.mlp_gate = nn.Parameter(torch.tensor(-1.5))

    def forward(self, x: Tensor, attention_mask: Tensor | None) -> Tensor:
        batch, length, width = x.shape
        q, k, v = self.qkv(self.norm1(x)).chunk(3, dim=-1)
        head_width = width // self.heads
        q = q.view(batch, length, self.heads, head_width).transpose(1, 2)
        k = k.view(batch, length, self.heads, head_width).transpose(1, 2)
        v = v.view(batch, length, self.heads, head_width).transpose(1, 2)
        mask = None
        if attention_mask is not None:
            mask = attention_mask[:, None, None, :].to(dtype=torch.bool, device=x.device)
        attn = F.scaled_dot_product_attention(q, k, v, attn_mask=mask)
        attn = attn.transpose(1, 2).contiguous().view(batch, length, width)
        a = torch.sigmoid(self.attn_gate) if STABILITY_GATES else 1.0
        m = torch.sigmoid(self.mlp_gate) if STABILITY_GATES else 1.0
        x = x + a * self.out(attn)
        x = x + m * self.down(F.silu(self.up(self.norm2(x))))
        return x


class NeuralTapeCell(nn.Module):
    def __init__(self, width: int) -> None:
        super().__init__()
        self.norm = RMSNorm(width)
        self.depthwise = nn.Conv1d(width, width, 3, padding=1, groups=width, bias=False)
        self.mix_in = nn.Linear(width, 3 * width, bias=False)
        self.mix_out = nn.Linear(width, width, bias=False)
        self.gate = nn.Parameter(torch.tensor(-1.5))

    def forward(self, x: Tensor, attention_mask: Tensor | None) -> Tensor:
        y = self.norm(x)
        local = self.depthwise(y.transpose(1, 2)).transpose(1, 2)
        value, update, reset = self.mix_in(y + local).chunk(3, dim=-1)
        candidate = torch.tanh(value + torch.sigmoid(reset) * local)
        delta = torch.sigmoid(update) * candidate
        scale = torch.sigmoid(self.gate) if STABILITY_GATES else 1.0
        return x + scale * self.mix_out(delta)


class Model(nn.Module):
    def __init__(self, spec: ModelSpec) -> None:
        super().__init__()
        self.config = Config(spec.vocab_size, spec.max_seq_len)
        self.token_embedding = nn.Embedding(spec.vocab_size, D_MODEL)
        self.position_embedding = nn.Embedding(spec.max_seq_len, D_MODEL)
        if ARCHITECTURE == "baseline":
            self.cell = OfficialBaselineBlock(D_MODEL, NUM_HEADS)
        elif ARCHITECTURE == "neural_tape":
            self.cell = NeuralTapeCell(D_MODEL)
        else:
            self.cell = TiedTransformerCell(D_MODEL, NUM_HEADS)
        self.final_norm = RMSNorm(D_MODEL)
        self.head = nn.Linear(D_MODEL, spec.vocab_size, bias=False)
        self.head.weight = self.token_embedding.weight
        self.num_loops = EVAL_LOOPS

    def _loops(self) -> int:
        if not self.training or TRAIN_LOOPS_MIN == TRAIN_LOOPS_MAX:
            return EVAL_LOOPS if not self.training else TRAIN_LOOPS_MAX
        return random.randint(TRAIN_LOOPS_MIN, TRAIN_LOOPS_MAX)

    def forward(self, input_ids: Tensor, attention_mask: Tensor | None = None):
        positions = torch.arange(input_ids.shape[1], device=input_ids.device)
        x = self.token_embedding(input_ids) + self.position_embedding(positions)
        deltas = []
        loops = 1 if ARCHITECTURE == "baseline" else self._loops()
        for _ in range(loops):
            previous = x
            x = self.cell(x, attention_mask)
            if NORMALIZE_STATE:
                x = F.rms_norm(x, (x.shape[-1],))
            if self.training and LOOP_CONSISTENCY_WEIGHT > 0.0:
                deltas.append((x - previous).float().pow(2).mean())
        auxiliary = None
        if deltas:
            stacked = torch.stack(deltas)
            auxiliary = {
                "loop_consistency": stacked.var(unbiased=False),
                "state_norm": x.float().pow(2).mean(),
            }
        return self.head(self.final_norm(x)), auxiliary

    @torch.no_grad()
    def trace_dynamics(
        self,
        input_ids: Tensor,
        attention_mask: Tensor | None = None,
        loops: int | None = None,
    ):
        positions = torch.arange(input_ids.shape[1], device=input_ids.device)
        x = self.token_embedding(input_ids) + self.position_embedding(positions)
        trace = []
        count = int(loops or EVAL_LOOPS)
        for index in range(count):
            previous = x
            x = self.cell(x, attention_mask)
            if NORMALIZE_STATE:
                x = F.rms_norm(x, (x.shape[-1],))
            state_rms = x.float().pow(2).mean().sqrt()
            delta_rms = (x - previous).float().pow(2).mean().sqrt()
            trace.append({
                "loop": index + 1,
                "state_rms": float(state_rms.item()),
                "delta_rms": float(delta_rms.item()),
                "finite": bool(torch.isfinite(x).all().item()),
            })
        return trace


def training_loss(logits: Tensor, labels: Tensor, auxiliary) -> Tensor:
    loss = F.cross_entropy(logits, labels.long())
    if auxiliary is not None and LOOP_CONSISTENCY_WEIGHT > 0.0:
        loss = loss + LOOP_CONSISTENCY_WEIGHT * auxiliary["loop_consistency"]
    return loss


@torch.no_grad()
def _zeropower_via_newton_schulz5(matrix: Tensor, steps: int) -> Tensor:
    x = matrix.bfloat16()
    transposed = x.shape[0] > x.shape[1]
    if transposed:
        x = x.T
    x = x / (x.norm() + 1e-7)
    a, b, c = 3.4445, -4.7750, 2.0315
    for _ in range(steps):
        aa = x @ x.T
        x = a * x + (b * aa + c * aa @ aa) @ x
    if transposed:
        x = x.T
    return x.to(matrix.dtype)


class Muon(torch.optim.Optimizer):
    def __init__(self, params, lr: float, momentum: float = 0.95, ns_steps: int = 3):
        super().__init__(params, dict(lr=lr, momentum=momentum, ns_steps=ns_steps))

    @torch.no_grad()
    def step(self, closure=None):
        loss = closure() if closure is not None else None
        for group in self.param_groups:
            for parameter in group["params"]:
                if parameter.grad is None:
                    continue
                grad = parameter.grad
                state = self.state[parameter]
                momentum = state.get("momentum_buffer")
                if momentum is None:
                    momentum = state["momentum_buffer"] = torch.zeros_like(grad)
                momentum.lerp_(grad, 1.0 - group["momentum"])
                update = _zeropower_via_newton_schulz5(momentum, group["ns_steps"])
                update.mul_(max(1.0, math.sqrt(parameter.shape[0] / parameter.shape[1])))
                parameter.add_(update, alpha=-group["lr"])
        return loss


class CompositeOptimizer:
    def __init__(self, optimizers) -> None:
        self.optimizers = list(optimizers)
        self.param_groups = [group for opt in self.optimizers for group in opt.param_groups]

    def zero_grad(self, set_to_none: bool = True) -> None:
        for optimizer in self.optimizers:
            optimizer.zero_grad(set_to_none=set_to_none)

    def step(self, closure=None):
        result = None
        for optimizer in self.optimizers:
            result = optimizer.step(closure if result is None else None)
        return result

    def state_dict(self):
        return {str(i): optimizer.state_dict() for i, optimizer in enumerate(self.optimizers)}


class WallClockSchedule:
    def __init__(self, optimizer, duration_seconds: float, warmup_fraction: float) -> None:
        self.optimizer = optimizer
        self.duration_seconds = max(1e-6, float(duration_seconds))
        self.warmup_fraction = max(0.0, min(0.5, float(warmup_fraction)))
        self.started_at = time.monotonic()
        self.base_lrs = [float(group["lr"]) for group in optimizer.param_groups]

    def step(self) -> None:
        progress = min(1.0, (time.monotonic() - self.started_at) / self.duration_seconds)
        if self.warmup_fraction > 0.0 and progress < self.warmup_fraction:
            scale = progress / self.warmup_fraction
        else:
            tail = (progress - self.warmup_fraction) / max(1e-6, 1.0 - self.warmup_fraction)
            scale = 0.5 * (1.0 + math.cos(math.pi * min(1.0, max(0.0, tail))))
        for group, base_lr in zip(self.optimizer.param_groups, self.base_lrs):
            group["lr"] = base_lr * scale


def _parameter_groups(model: nn.Module):
    matrix, auxiliary = [], []
    core, boundary = [], []
    for name, parameter in model.named_parameters():
        if parameter.ndim == 2 and "embedding" not in name and "head" not in name:
            matrix.append(parameter)
        else:
            auxiliary.append(parameter)
        if name.startswith("cell."):
            core.append(parameter)
        else:
            boundary.append(parameter)
    return matrix, auxiliary, core, boundary


def build_model(spec: ModelSpec) -> Model:
    model = Model(spec)
    assert_model_state(model, spec)
    return model


def build_optimizer(model: nn.Module, spec: OptimizerSpec) -> OptimizerBundle:
    if ARCHITECTURE == "baseline":
        return OptimizerBundle(
            torch.optim.AdamW(
                model.parameters(),
                lr=1e-3,
                betas=(0.9, 0.95),
                weight_decay=0.1,
                capturable=spec.device_type == "cuda",
            )
        )
    matrix, auxiliary, core, boundary = _parameter_groups(model)
    if OPTIMIZER == "hybrid_muon":
        opts = []
        if matrix:
            opts.append(Muon(matrix, lr=LEARNING_RATE, ns_steps=MUON_NS_STEPS))
        if auxiliary:
            opts.append(torch.optim.AdamW(
                auxiliary,
                lr=LEARNING_RATE,
                betas=(0.9, 0.95),
                weight_decay=WEIGHT_DECAY,
                capturable=spec.device_type == "cuda",
            ))
        optimizer = CompositeOptimizer(opts)
    elif OPTIMIZER == "groupwise_adamw":
        optimizer = torch.optim.AdamW([
            {
                "params": core,
                "lr": LEARNING_RATE,
                "betas": (0.92, 0.99),
                "weight_decay": WEIGHT_DECAY,
            },
            {
                "params": boundary,
                "lr": LEARNING_RATE * 0.7,
                "betas": (0.9, 0.95),
                "weight_decay": WEIGHT_DECAY,
            },
        ], capturable=spec.device_type == "cuda")
    else:
        optimizer = torch.optim.AdamW(
            model.parameters(),
            lr=LEARNING_RATE,
            betas=(0.9, 0.95),
            weight_decay=WEIGHT_DECAY,
            capturable=spec.device_type == "cuda",
        )
    scheduler = WallClockSchedule(optimizer, spec.training_time_seconds, WARMUP_FRACTION)
    return OptimizerBundle(optimizer, scheduler)


SUBMISSION = Submission(
    build_model=build_model,
    build_optimizer=build_optimizer,
    training_loss=training_loss if LOOP_CONSISTENCY_WEIGHT > 0.0 else None,
    batch_size=BATCH_SIZE,
    max_steps=MAX_STEPS,
)
